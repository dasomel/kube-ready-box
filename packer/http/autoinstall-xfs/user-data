#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  refresh-installer:
    update: no
  keyboard:
    layout: us

  identity:
    hostname: vagrant-ubuntu
    username: vagrant
    password: '$6$rounds=4096$5CU3LEj/MQvbkfPb$LmKEF9pCfU8R.dA.GemgE/8GT6r9blge3grJvdsVTMFKyLEQwzEF3SGWqAzjawY/XHRpWj4fOiLBrRyxJhIRJ1'
    # password: vagrant (hashed - verified from HashiCorp template)

  ssh:
    install-server: true
    allow-pw: true

  storage:
    config:
      - id: disk0
        type: disk
        ptable: gpt
        preserve: false
        grub_device: true
        match:
          size: largest
      - id: efi-partition
        type: partition
        size: 512M
        device: disk0
        flag: boot
        grub_device: true
      - id: efi-fs
        type: format
        fstype: fat32
        volume: efi-partition
      - id: boot-partition
        type: partition
        size: 1G
        device: disk0
      - id: boot-fs
        type: format
        fstype: ext4
        volume: boot-partition
      - id: lvm-partition
        type: partition
        size: -1
        device: disk0
      - id: ubuntu-vg
        type: lvm_volgroup
        name: ubuntu-vg
        devices:
          - lvm-partition
      - id: ubuntu-lv
        type: lvm_partition
        name: ubuntu-lv
        volgroup: ubuntu-vg
        size: 100%
      - id: root-fs
        type: format
        fstype: xfs
        volume: ubuntu-lv
      - id: mount-root
        type: mount
        path: /
        device: root-fs
      - id: mount-boot
        type: mount
        path: /boot
        device: boot-fs
      - id: mount-efi
        type: mount
        path: /boot/efi
        device: efi-fs

  packages:
    - util-linux-extra
    - open-vm-tools
    - xfsprogs

  network:
    network:
      version: 2
      ethernets:
        main_if:
          match:
            name: "en*"
          dhcp4: true

  user-data:
    package_upgrade: true
    disable_root: false
    timezone: UTC

  late-commands:
    - mkdir -p /target/etc/kube-ready
    - >-
      ip -4 -o addr show scope global | awk '$2 ~ /^en/ && $4 !~ /^127\./ { print "PACKER_INSTALLER_IFACE=" $2; print "PACKER_INSTALLER_CIDR=" $4; exit }' > /target/etc/kube-ready/packer-installer-ip.env && test -s /target/etc/kube-ready/packer-installer-ip.env
    - |
      cat > /target/etc/systemd/system/kube-ready-packer-lease-bridge.service <<'EOF'
      [Unit]
      Description=Temporarily restore the Packer installer DHCP address
      Wants=network-online.target
      After=network-online.target
      ConditionPathExists=/etc/kube-ready/packer-installer-ip.env

      [Service]
      Type=oneshot
      EnvironmentFile=/etc/kube-ready/packer-installer-ip.env
      ExecStart=/bin/sh -c '/usr/sbin/ip address add "$PACKER_INSTALLER_CIDR" dev "$PACKER_INSTALLER_IFACE" 2>/dev/null || true'
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target
      EOF
    - curtin in-target -- systemctl enable kube-ready-packer-lease-bridge.service
    - sed -i 's/#LogLevel INFO/LogLevel DEBUG/' /target/etc/ssh/sshd_config
    - sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /target/etc/ssh/sshd_config
    - sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /target/etc/ssh/sshd_config
    - sed -i 's/^#*PubkeyAuthentication.*/PubkeyAuthentication yes/' /target/etc/ssh/sshd_config
    - curtin in-target -- systemctl enable ssh.service
    - echo 'vagrant ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/vagrant
    - chmod 440 /target/etc/sudoers.d/vagrant
    # XFS prjquota: K8s ephemeral storage quota (--local-storage-capacity-isolation)
    # 1. fstab: systemd remount with prjquota (match xfs root mount line)
    - "sed -i '/ \\/ .*xfs/ s/defaults/defaults,prjquota/' /target/etc/fstab"
    # 2. grub rootflags: initramfs mounts root with prjquota from the start
    - "sed -i 's/GRUB_CMDLINE_LINUX=\"\"/GRUB_CMDLINE_LINUX=\"rootflags=prjquota\"/' /target/etc/default/grub"
    - curtin in-target -- update-grub
    # 3. initramfs: bake prjquota into initramfs
    - curtin in-target -- update-initramfs -u -k all
